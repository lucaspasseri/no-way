# Use the PostgreSQL URL for this application's database. Never prefix it NEXT_PUBLIC_.
# Keep your existing .env; this example contains placeholders only.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/no_way_dev
# Hosted providers may require ?sslmode=verify-full (use their supplied URL).

# Create a key at https://openrouter.ai/keys. Keep the actual key in .env or server secrets.
OPENROUTER_API_KEY=
# Optional model slug from https://openrouter.ai/models; CLI arguments take precedence.
OPENROUTER_MODEL=particle-ai/particle-1:free

# AI candidate generation requires a model/provider with strict JSON Schema output support.
# The questions CLI accepts --model to override OPENROUTER_MODEL. No AI key is needed for gameplay.
