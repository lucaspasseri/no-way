{
  "name": "no-way",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-test-module-mocks --import ./tests/register.mjs --test src/features/game/*.test.mjs src/features/lab/*.test.mjs src/lib/*.test.mjs src/server/*.test.mjs src/app/api/questions/*.test.mjs src/app/api/challenge/*.test.mjs src/app/api/question-lab/*.test.mjs db/*.test.mjs scripts/*.test.mjs",
    "openrouter:test": "node --env-file-if-exists=.env scripts/openrouter.mjs",
    "test:integration": "node --test tests/streaming.test.mjs",
    "test:db": "node --env-file=.env --import ./tests/register.mjs --test db/database.integration.mjs",
    "db:schema": "node --env-file=.env db/schema.mjs",
    "db:lab": "node --env-file=.env db/schema.mjs --lab-only",
    "db:seed": "node --env-file=.env db/seed.mjs",
    "db:export:schema": "node db/export-schema.mjs",
    "db:export:seed": "node db/export-seed.mjs",
    "db:reset": "node --env-file=.env db/reset.mjs",
    "questions": "node --env-file-if-exists=.env scripts/questions.mjs",
    "test:selection:local": "node --import ./tests/register.mjs --test tests/question-selection.local.mjs",
    "test:db:local": "node --import ./tests/register.mjs --test tests/database.local.mjs",
    "test:lab:local": "node --import ./tests/register.mjs --test tests/question-lab.local.mjs tests/lab-diagnostics.local.mjs tests/lab-recovery.local.mjs",
    "questions:export-sql": "node scripts/export-questions.mjs",
    "questions:dataset": "node scripts/question-dataset.mjs",
    "db:traces": "node --env-file=.env db/schema.mjs --traces-only",
    "db:recovery": "node --env-file=.env db/schema.mjs --recovery-only",
    "openrouter:traces": "node --env-file-if-exists=.env scripts/openrouter-traces.mjs",
    "test:traces:local": "node --experimental-test-module-mocks --import ./tests/register.mjs --test tests/openrouter-traces.local.mjs"
  },
  "dependencies": {
    "@openrouter/sdk": "^1.5.103",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-feather": "^2.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5"
  }
}
